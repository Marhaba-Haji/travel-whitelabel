# Supabase (from Dashboard > Settings > API - use service_role key, not anon)
SUPABASE_URL=https://kofijegdzeshitunwddn.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# PayU Merchant Key (from PayU Dashboard > Developer > API Details)
PAYU_KEY=

# Salt 32-bit (from PayU Dashboard)
PAYU_SALT_32=

# Salt 256-bit - use this if your PayU account uses 256-bit salt instead
# PAYU_SALT_256=

# test | production
PAYU_MODE=test

# Frontend URL (where users are redirected after PayU callback)
BASE_URL=http://localhost:8080

# Backend URL (where PayU posts success/failure - must be publicly accessible)
# Defaults to http://localhost:PORT when not set
# BACKEND_URL=https://api.yourdomain.com
