# Frontend: API base URL
# - Empty or same-origin: uses relative URLs (e.g. /api/contact)
# - Set when API is on different domain: e.g. https://api.yourdomain.com or http://localhost:3001
# VITE_API_URL=

# Optional (dev): pre-fill Umrah visa check step — use .env.development.local (gitignored) for real values
# VITE_VISA_TEST_PASSPORT=T4548949
# VITE_VISA_TEST_FIRST_NAME=ZIAULLA
# VITE_VISA_TEST_COUNTRY=IND

# Gemini API key is now stored as a Supabase secret (GEMINI_API_KEY)

# Backend (server/.env): PayU credentials - NEVER commit real values
# PAYU_KEY=your_merchant_key
# PAYU_SALT_32=your_salt_32_bit
# PAYU_SALT_256=your_salt_256_bit
# PAYU_MODE=test
# BASE_URL=http://localhost:8080
