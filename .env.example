# Frontend: API base URL
# - Empty or same-origin: uses relative URLs (e.g. /api/contact)
# - Set when API is on different domain: e.g. https://api.yourdomain.com or http://localhost:3001
# VITE_API_URL=

# Gemini API key for Nyra voice AI widget (from https://aistudio.google.com/apikey)
# VITE_GEMINI_API_KEY=

# Backend (server/.env): PayU credentials - NEVER commit real values
# PAYU_KEY=your_merchant_key
# PAYU_SALT_32=your_salt_32_bit
# PAYU_SALT_256=your_salt_256_bit
# PAYU_MODE=test
# BASE_URL=http://localhost:8080
